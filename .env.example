# Copy to .env and replace every example password before starting Docker Compose.
DB_USER=cpms_app
DB_PASSWORD=replace-with-a-unique-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
APP_ADMIN_USERNAME=admin-local
APP_ADMIN_PASSWORD=replace-with-a-unique-admin-password
APP_VIEWER_USERNAME=viewer-local
APP_VIEWER_PASSWORD=replace-with-a-unique-viewer-password
